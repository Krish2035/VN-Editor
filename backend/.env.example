# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# 1. PostgreSQL Database (Pillars 25-32)
# Example: postgresql://username:password@localhost:5432/vneditor?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vneditor?schema=public"

# 2. Redis Distributed Cache & Queue (Pillars 15, 20)
# Example: redis://localhost:6379
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 3. Cloud Object Storage: AWS S3 / Cloudflare R2 / MinIO (Pillars 48, 88)
# For AWS S3:
S3_BUCKET="vn-editor-production"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# For Cloudflare R2 / MinIO (Optional custom endpoint):
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_PUBLIC_CDN_URL="https://media.vneditor.com"

# 4. Authentication & Security (Pillars 69-70, 112)
JWT_SECRET="vn_editor_production_super_secret_jwt_token_2026_change_in_prod"
